{
  "domain": "apple_tv_control",
  "name": "Apple TV Control",
  "categories": ["media_entertainment.tv_streaming"],
  "codeowners": ["@thbonk"],
  "config_flow": true,
  "dependencies": ["zeroconf"],
  "documentation": "https://github.com/home-assistant-integrations/apple-tv-control#readme",
  "integration_type": "hub",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/home-assistant-integrations/apple-tv-control/issues",
  "loggers": ["pyatv"],
  "requirements": ["pyatv>=0.18.0"],
  "version": "2026.11.5",
  "zeroconf": [
    "_mediaremotetv._tcp.local.",
    {
      "type": "_airplay._tcp.local.",
      "properties": {
        "model": "appletv*"
      }
    }
  ]
}
